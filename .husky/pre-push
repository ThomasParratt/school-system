# Runs before every push: the fast part of what CI checks.
set -e

echo "🧪 Type check and tests before push…"
npm run typecheck

# The backend tests need the test database (db_test in docker-compose.dev.yml).
# Without this check they wait two minutes for it before failing.
if ! node -e "require('net').connect(5433, 'localhost').on('connect', () => process.exit(0)).on('error', () => process.exit(1))"; then
  echo ""
  echo "❌ The test database is not running on localhost:5433."
  echo "   Start it with: docker compose -f docker-compose.dev.yml up -d db_test"
  exit 1
fi
npm test

echo "✅ Ready to push"
